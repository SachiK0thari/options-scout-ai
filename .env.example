# Copy to .env. Nothing here is required for `make demo` (fixture mode).

# --- Modes -----------------------------------------------------------------
# fixture = offline snapshots in tests/fixtures (default, CI-safe); live = real sources
OPTIONS_SCOUT_DATA_MODE=fixture
# fixture = replay cached LLM outputs; live = call the provider in config/settings.yaml llm.provider
# (openrouter by default; anthropic / openrouter force one); none = skip LLM steps
OPTIONS_SCOUT_LLM_MODE=fixture

# --- LLM -------------------------------------------------------------------
# OpenRouter (default live provider, model deepseek/deepseek-v4.1-flash): https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# Anthropic (set llm.provider: anthropic in config/settings.yaml or OPTIONS_SCOUT_LLM_MODE=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# --- Market data (live mode only; fixture mode needs nothing) ---------------
# MarketData.app (default): https://www.marketdata.app/ -> dashboard -> API token. The free plan
# is delayed and allows ~100 credits/day; an option chain costs 1 credit per contract, so
# market_data.marketdata.strike_limit in config/settings.yaml trims chains (default 60 strikes).
# MARKETDATA_TOKEN=
# Tradier instead: set the provider and paste a key; a free developer (sandbox) token gives
# 15-minute delayed quotes and chains. ^VIX/^IRX then come from MarketData.app if that token
# is also set. The web page and POST /v1/recommend accept either key per run, never written.
# OPTIONS_SCOUT_MARKET_PROVIDER=tradier
# TRADIER_API_KEY=

# --- Consumer-trend sources (live mode only) --------------------------------
# Which sources run is set in config/social_sources.yaml; override per run with a comma list of
# reddit,x,wikipedia,google_trends,news (at least one post source: reddit or x).
# OPTIONS_SCOUT_SOCIAL_SOURCES=reddit,x,wikipedia,google_trends,news

# Reddit: the default provider (Arctic Shift archive API) needs no credentials. These are for the
# PRAW backup / primary once Reddit approves the app (reddit.providers in config/social_sources.yaml).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Reddit's required format: <platform>:<app id>:<version> (by /u/<your reddit username>)
# REDDIT_USER_AGENT=python:ai.optionsscout:0.1.0 (by /u/Prestigious_Poet4615)

# X (API v2 app bearer token; search/recent needs the Basic tier, search/all the Pro tier)
# X_BEARER_TOKEN=

# Google Trends needs no key but the optional client: pip install -e ".[trends]"

# --- Bottleneck sources (Phase 11, live mode only) --------------------------
# Which sources run is set in config/bottleneck_sources.yaml; override per run with a comma list of
# edgar,fred,csv_series,transcripts,news,reddit,google_trends (at least one text source).
# OPTIONS_SCOUT_BOTTLENECK_SOURCES=edgar,fred,news
# FRED (producer-price series per layer), free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
# EDGAR full-text search needs no key; it sends OPTIONS_SCOUT_CONTACT_EMAIL (below) in the User-Agent.

# --- Contact email sent in User-Agent to SEC / Wikimedia (polite, required by SEC) ---
# OPTIONS_SCOUT_CONTACT_EMAIL=you@example.com

# --- Knowledge base (RAG) ----------------------------------------------------
# hash (default, offline, used by CI) or fastembed (pip install -e ".[rag]", downloads BAAI/bge-small-en-v1.5)
# OPTIONS_SCOUT_RAG_EMBEDDER=hash

# --- Observability ---------------------------------------------------------
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=options-scout-ai

# --- Storage ---------------------------------------------------------------
# Conversation threads live in paths.checkpoint_db (config/settings.yaml, data/checkpoints.sqlite);
# this moves them elsewhere (the test suite sets it to a temp file). Threads idle longer than
# agent.checkpoint_retention_days (7) are deleted when the file is opened.
# OPTIONS_SCOUT_CHECKPOINT_DB=data/checkpoints.sqlite

# --- API -------------------------------------------------------------------
# API key clients must send in `X-API-Key` (leave unset to disable auth in local dev)
# OPTIONS_SCOUT_API_KEY=
